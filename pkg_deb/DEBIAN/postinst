#!/bin/sh
set -e
case "$1" in
    configure)
        mkdir -p /etc/travel-net
        systemctl enable travel-net.service 2>/dev/null || true
        echo ""
        echo "travel-net: Web UI at http://192.168.4.1"
        echo "travel-net: AP SSID 'Travel-Net' (password: travelnet)"
        ;;
esac
