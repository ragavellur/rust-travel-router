#!/bin/sh
set -e

setup_ro_rootfs() {
    echo ""
    echo "============================================"
    echo "  Read-Only Rootfs Setup"
    echo "============================================"
    echo ""
    echo "This protects your SD/eMMC from corruption"
    echo "during sudden power loss."
    echo ""
    printf "Enable read-only rootfs? [Y/n] "
    read -r answer </dev/tty 2>/dev/null || answer="y"
    case "$answer" in
        [nN]|[nN][oO])
            echo "Skipping read-only rootfs setup."
            return 1
            ;;
        *)
            echo "Setting up read-only rootfs..."
            return 0
            ;;
    esac
}

detect_backend() {
    if command -v nmcli >/dev/null 2>&1 && command -v NetworkManager >/dev/null 2>&1; then
        echo "networkmanager"
    else
        echo "hostapd"
    fi
}

setup_nm_backend() {
    mkdir -p /etc/systemd/system/NetworkManager.service.d
    cat > /etc/systemd/system/NetworkManager.service.d/override.conf << 'EOF'
[Service]
ReadWritePaths=/etc/NetworkManager/system-connections
ReadWritePaths=/var/lib/NetworkManager
ReadWritePaths=/etc/NetworkManager/dnsmasq-shared.d
EOF

    if ! nmcli connection show travel-net-hotspot >/dev/null 2>&1; then
        AP_IF=""
        for iface in wlan1 wlan2; do
            if [ -d "/sys/class/net/$iface" ]; then
                AP_IF="$iface"
                break
            fi
        done
        if [ -n "$AP_IF" ]; then
            nmcli connection add type wifi con-name travel-net-hotspot \
                ifname "$AP_IF" ssid Travel-Net mode ap 2>/dev/null || true
        fi
    fi
}

setup_hostapd_backend() {
    mkdir -p /etc/hostapd /etc/wpa_supplicant
}

update_config_rootfs() {
    # Update rootfs_readonly in config.json
    CONFIG_FILE="/etc/travel-net/config.json"
    if [ -f "$CONFIG_FILE" ]; then
        if [ "$1" = "true" ]; then
            # Use python if available, else sed
            if command -v python3 >/dev/null 2>&1; then
                python3 -c "
import json
with open('$CONFIG_FILE') as f: c = json.load(f)
c['rootfs_readonly'] = True
with open('$CONFIG_FILE', 'w') as f: json.dump(c, f, indent=2)
" 2>/dev/null || sed -i 's/"rootfs_readonly": *false/"rootfs_readonly": true/' "$CONFIG_FILE"
            else
                sed -i 's/"rootfs_readonly": *false/"rootfs_readonly": true/' "$CONFIG_FILE"
            fi
        else
            if command -v python3 >/dev/null 2>&1; then
                python3 -c "
import json
with open('$CONFIG_FILE') as f: c = json.load(f)
c['rootfs_readonly'] = False
with open('$CONFIG_FILE', 'w') as f: json.dump(c, f, indent=2)
" 2>/dev/null || sed -i 's/"rootfs_readonly": *true/"rootfs_readonly": false/' "$CONFIG_FILE"
            else
                sed -i 's/"rootfs_readonly": *true/"rootfs_readonly": false/' "$CONFIG_FILE"
            fi
        fi
    fi
}

case "$1" in
    configure)
        mkdir -p /etc/travel-net

        if [ ! -f /etc/travel-net/config.json ]; then
            cp /usr/share/travel-net/config.default.json /etc/travel-net/config.json 2>/dev/null || true
        fi

        BACKEND=$(detect_backend)
        echo "travel-net: detected backend = $BACKEND"

        # Ask about RO rootfs
        ENABLE_RO=0
        if [ -t 0 ] || [ -t 1 ]; then
            setup_ro_rootfs && ENABLE_RO=1
        else
            echo "travel-net: non-interactive install, enabling RO rootfs by default"
            ENABLE_RO=1
        fi

        if [ "$ENABLE_RO" = "1" ]; then
            if [ "$BACKEND" = "networkmanager" ]; then
                setup_nm_backend
            else
                setup_hostapd_backend
            fi

            systemctl enable travel-net-overlay.service 2>/dev/null || true
            update_config_rootfs "true"
            echo "travel-net: read-only rootfs enabled (overlay service active)"
        else
            systemctl disable travel-net-overlay.service 2>/dev/null || true
            update_config_rootfs "false"
            echo "travel-net: read-only rootfs disabled (rootfs stays writable)"
        fi

        # Install Tailscale (best-effort)
        if ! command -v tailscale >/dev/null 2>&1; then
            if command -v curl >/dev/null 2>&1; then
                TS_OS=debian
                DISTRO=$(grep -E '^ID=' /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' | tr '[:upper:]' '[:lower:]')
                case "$DISTRO" in
                    raspbian) TS_OS=raspbian ;;
                    ubuntu) TS_OS=ubuntu ;;
                esac
                TS_VER=$(grep -E '^VERSION_CODENAME=' /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')
                [ -n "$TS_VER" ] || TS_VER=stable
                echo "travel-net: installing Tailscale ($TS_OS/$TS_VER) via apt repo..."
                mkdir -p --mode=0755 /usr/share/keyrings
                curl -fsSL "https://pkgs.tailscale.com/stable/$TS_OS/$TS_VER.noarmor.gpg" -o /usr/share/keyrings/tailscale-archive-keyring.gpg || true
                curl -fsSL "https://pkgs.tailscale.com/stable/$TS_OS/$TS_VER.tailscale-keyring.list" -o /etc/apt/sources.list.d/tailscale.list || true
                chmod 0644 /etc/apt/sources.list.d/tailscale.list 2>/dev/null || true
                apt-get update || true
                apt-get install -y tailscale || true
            fi
        fi
        systemctl disable tailscaled 2>/dev/null || true

        systemctl daemon-reload
        systemctl enable travel-net.service
        systemctl restart travel-net.service || true

        echo ""
        echo "travel-net: Web UI available at http://192.168.4.1"
        echo "travel-net: Connect to AP SSID 'Travel-Net' (password: travelnet)"
        ;;
esac
