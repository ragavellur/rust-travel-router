[Unit]
Description=Sync system clock via NTP (best-effort, non-blocking)
DefaultDependencies=no
After=network-online.target network.target
Wants=network-online.target
Before=travel-net.service travel-net-tailscale.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/travel-net-timesync
RemainAfterExit=yes
StandardOutput=journal

[Install]
WantedBy=multi-user.target
