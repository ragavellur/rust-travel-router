[Unit]
Description=Sync system clock via NTP
DefaultDependencies=no
After=network-online.target
Wants=network-online.target
Before=travel-net-overlay.service travel-net.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/travel-net-timesync
RemainAfterExit=yes
StandardOutput=journal

[Install]
WantedBy=multi-user.target
