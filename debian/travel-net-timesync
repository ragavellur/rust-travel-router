#!/bin/bash
# travel-net-timesync: best-effort clock sync at boot. Non-blocking.
# If clock is wrong, boot continues — web UI shows warning with fix button.
# Services that need correct time (tailscale install) wait for clock on their own.

check_clock() {
    YEAR=$(date +%Y 2>/dev/null)
    [ -n "$YEAR" ] && [ "$YEAR" -ge 2024 ] 2>/dev/null
}

# Already correct? Bail immediately.
if check_clock; then
    echo "travel-net-timesync: clock already correct ($(date))"
    exit 0
fi

echo "travel-net-timesync: clock wrong ($(date)), attempting sync..."

# Method 1: systemd-timesyncd (wait up to 10s)
if command -v timedatectl >/dev/null 2>&1; then
    timedatectl set-ntp true 2>/dev/null || true
    for i in $(seq 1 10); do
        if check_clock; then
            echo "travel-net-timesync: synced via systemd-timesyncd ($(date))"
            exit 0
        fi
        sleep 1
    done
fi

# Method 2: ntpdate by IP (no DNS needed)
if command -v ntpdate >/dev/null 2>&1; then
    ntpdate -b 216.239.35.12 2>/dev/null && check_clock && echo "travel-net-timesync: synced via ntpdate ($(date))" && exit 0
    ntpdate -b 216.239.37.12 2>/dev/null && check_clock && echo "travel-net-timesync: synced via ntpdate ($(date))" && exit 0
fi

# Clock still wrong — don't block. Web UI warns the user, tailscale waits on its own.
echo "travel-net-timesync: clock still wrong ($(date)) — will sync when network is available"
exit 0
