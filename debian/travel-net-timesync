#!/bin/bash
# travel-net-timesync: sync system clock before anything else runs.
# Primary: timedatectl (systemd-timesyncd, always available, no extra deps)
# Fallback: ntpdate by IP (no DNS needed)
set -e

# Method 1: systemd-timesyncd (always installed on Debian, no extra package)
if command -v timedatectl >/dev/null 2>&1; then
    timedatectl set-ntp true 2>/dev/null
    # Wait up to 5 seconds for sync
    for i in 1 2 3 4 5; do
        if timedatectl show-property NTPSynchronized --value 2>/dev/null | grep -q "yes"; then
            echo "travel-net-timesync: synced via systemd-timesyncd"
            exit 0
        fi
        sleep 1
    fi
    echo "travel-net-timesync: systemd-timesyncd started but not yet synced (will sync in background)"
    exit 0
fi

# Method 2: ntpdate by IP (no DNS needed)
if command -v ntpdate >/dev/null 2>&1; then
    ntpdate -b 216.239.35.12 2>/dev/null && echo "travel-net-timesync: synced via ntpdate (Google)" && exit 0
    ntpdate -b 216.239.37.12 2>/dev/null && echo "travel-net-timesync: synced via ntpdate (Google)" && exit 0
fi

echo "travel-net-timesync: no NTP method available, time may be incorrect"
exit 0
