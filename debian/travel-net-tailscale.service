[Unit]
Description=Install Tailscale (travel-net first-boot)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/travel-net/.tailscale-installed

[Service]
Type=oneshot
ExecStart=/usr/sbin/travel-net-tailscale
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
