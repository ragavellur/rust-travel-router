#!/bin/bash
# travel-net-overlay: create writable tmpfs bind-mounts over directories
# that the system and travel-net need to write to at runtime.
#
# This script ALWAYS creates bind-mounts regardless of rootfs state.
# On rw rootfs: harmless — writes go to tmpfs, save_config() persists to ext4.
# On ro rootfs: essential — without this, NM/travel-net can't write anything.
#
# CRITICAL: This script MUST NOT use 'set -e'. Every command tolerates failure.
# If any bind-mount fails, we log and continue.

log() { echo "travel-net-overlay: $*"; logger -t travel-net-overlay "$*"; }

overlay_bind() {
    local src="$1"
    local tmpdir="/run/overlay-$(echo "$src" | tr '/' '_' | sed 's/^_//')"

    # Already mounted — nothing to do
    if mountpoint -q "$src" 2>/dev/null; then
        log "OK $src (already mounted)"
        return 0
    fi

    # Source dir must exist
    if [ ! -d "$src" ]; then
        mkdir -p "$src" 2>/dev/null || { log "FAIL $src: cannot create dir"; return 0; }
    fi

    # Tmpdir on /run (tmpfs, always writable, never cleaned by tmpfiles)
    if [ ! -d "$tmpdir" ]; then
        mkdir -p "$tmpdir" 2>/dev/null || { log "FAIL $src: cannot create tmpdir $tmpdir"; return 0; }
    fi

    # Copy existing content into tmpdir
    cp -a "$src"/. "$tmpdir/" 2>/dev/null || true

    # Bind-mount tmpdir over the source
    if mount --bind "$tmpdir" "$src" 2>/dev/null; then
        log "OK $tmpdir -> $src"
    else
        log "FAIL $src: mount --bind failed (errno=$?)"
    fi
}

log "starting overlay setup"

# === travel-net config (all devices) ===
overlay_bind "/etc/travel-net"

# === NetworkManager backend dirs ===
if command -v nmcli >/dev/null 2>&1 || [ -d /etc/NetworkManager ]; then
    overlay_bind "/etc/NetworkManager/system-connections"
    overlay_bind "/etc/NetworkManager/dnsmasq-shared.d"
    overlay_bind "/etc/NetworkManager/conf.d"
fi

# === hostapd backend dirs ===
if command -v hostapd >/dev/null 2>&1 || [ -d /etc/hostapd ]; then
    overlay_bind "/etc/hostapd"
fi

# === wpa_supplicant config (both backends) ===
mkdir -p /etc/wpa_supplicant 2>/dev/null || true
overlay_bind "/etc/wpa_supplicant"

# === dnsmasq config ===
if [ -d /etc/dnsmasq.d ]; then
    overlay_bind "/etc/dnsmasq.d"
fi

# === APT/dpkg (needed for install/upgrade) ===
overlay_bind "/var/lib/dpkg"
overlay_bind "/var/cache/apt"
overlay_bind "/var/lib/apt"
overlay_bind "/etc/apt/sources.list.d"
overlay_bind "/usr/share/keyrings"

# === VPN and driver configs ===
overlay_bind "/etc/wireguard"
overlay_bind "/etc/modprobe.d"

# === System runtime state ===
overlay_bind "/var/lib/NetworkManager"
overlay_bind "/var/lib/systemd"
overlay_bind "/var/log"
overlay_bind "/var/tmp"

# === DNS resolver ===
RESOLV_TMPDIR="/run/overlay-etc_resolv_conf"
if [ ! -d "$RESOLV_TMPDIR" ]; then
    mkdir -p "$RESOLV_TMPDIR" 2>/dev/null || { log "FAIL: cannot create resolv tmpdir"; exit 0; }
fi

if [ -f /etc/resolv.conf ] && [ ! -L /etc/resolv.conf ]; then
    cp -a /etc/resolv.conf "$RESOLV_TMPDIR/resolv.conf" 2>/dev/null || true
fi
if [ ! -f "$RESOLV_TMPDIR/resolv.conf" ] || ! grep -q '^nameserver ' "$RESOLV_TMPDIR/resolv.conf" 2>/dev/null; then
    cat > "$RESOLV_TMPDIR/resolv.conf" << 'RESOLV'
# Default DNS — managed by travel-net overlay
nameserver 8.8.8.8
nameserver 1.1.1.1
RESOLV
fi
if ! mountpoint -q /etc/resolv.conf 2>/dev/null; then
    if mount --bind "$RESOLV_TMPDIR/resolv.conf" /etc/resolv.conf 2>/dev/null; then
        log "OK $RESOLV_TMPDIR/resolv.conf -> /etc/resolv.conf"
    else
        log "FAIL /etc/resolv.conf: mount --bind failed"
    fi
fi

# === Verify critical overlays ===
OVERLAY_OK=0
OVERLAY_FAIL=0
for dir in /etc/travel-net /etc/NetworkManager/system-connections /var/lib/NetworkManager; do
    if mountpoint -q "$dir" 2>/dev/null; then
        OVERLAY_OK=$((OVERLAY_OK + 1))
    else
        OVERLAY_FAIL=$((OVERLAY_FAIL + 1))
        log "CRITICAL: $dir overlay NOT active!"
    fi
done

log "overlay setup complete: $OVERLAY_OK ok, $OVERLAY_FAIL failed"
exit 0
